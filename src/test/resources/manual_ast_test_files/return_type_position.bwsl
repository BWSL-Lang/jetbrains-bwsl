// Gap: a function's return type has no position in the AST, and a qualified one has no edge at all.
// See BWSLC_GAPS.md #1.

module Common {
    struct Box {
        float size;
    }
}

module M {
    struct Local {
        float size;
    }

    // `Local` here has a FUNCTION -> STRUCT_DECL [return-type] edge, but no line/column says where
    // the text `Local` is written, so the edge can't be tied to a caret on it.
    // (The body's `Local l;` is fine: a VARIABLE_DECL has typeLine/typeColumn.)
    plain :: () -> Local {
        Local l;
        return l;
    }

    // `Common::Box` here has NO edge at all (not even to Box), no position, and the function's
    // returnType in the AST is just "Box" - the `Common::` is dropped.
    // Compare the body's `Common::Box b;`, which gets a positioned typeQualifier for `Common`
    // and a [qualifier] edge to the module.
    qualified :: () -> Common::Box {
        Common::Box b;
        return b;
    }
}
